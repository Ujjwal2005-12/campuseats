<?xml version="1.0" encoding="UTF-8"?>

<definitions
    name="CampusPayGateway"
    targetNamespace="http://example.com/campuspay"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:tns="http://example.com/campuspay"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">


    <types>

        <xsd:schema
            targetNamespace="http://example.com/campuspay">

            <xsd:element name="charge">
                <xsd:complexType>
                    <xsd:sequence>

                        <xsd:element name="orderId" type="xsd:string"/>
                        <xsd:element name="amount" type="xsd:decimal"/>
                        <xsd:element name="paymentMethodId" type="xsd:string"/>
                        <xsd:element name="currency" type="xsd:string"/>

                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

        

        <xsd:element name="chargeResponse">
            <xsd:complexType>
                <xsd:sequence>

                    <xsd:element name="transactionId" type="xsd:string"/>
                    <xsd:element name="status" type="xsd:string"/>

                 </xsd:sequence>
            </xsd:complexType>
        </xsd:element>
     </xsd:schema>
    </types>

    <message name="ChargeRequest">
        <part name="parameters" element="tns:charge"/>
    </message>

    <message name="ChargeResponse">
        <part name="parameters" element="tns:chargeResponse"/>
    </message>

    <portType name="PaymentPortType">

        <operation name="charge">

            <input message="tns:ChargeRequest"/>

            <output message="tns:ChargeResponse"/>

        </operation>

    </portType>


    <binding name="PaymentBinding" type="tns:PaymentPortType">

    <soap:binding
        style="document"
        transport="http://schemas.xmlsoap.org/soap/http"/>

    <operation name="charge">

        <soap:operation soapAction="http://example.com/campuspay/charge"/>

        <input>
            <soap:body use="literal"/>
        </input>

        <output>
            <soap:body use="literal"/>
        </output>

    </operation>

</binding>

<service name="CampusPayGatewayService">

    <port name="PaymentPort" binding="tns:PaymentBinding">

        <soap:address location="https://api.campuspay.example.com/soap"/>

    </port>

</service>

</definitions>